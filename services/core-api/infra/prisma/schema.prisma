generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model JobSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  jobId      String    @unique @db.Uuid
  operatorId String    @db.Uuid
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([operatorId])
  @@map("job_subscriptions")
}

enum UserType {
  operator
  local_owner

  @@map("user_type")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  type         UserType
  name         String?
  age          Int?
  phone        String?
  position     String?
  bio          String?
  createdAt    DateTime @default(now())

  @@map("users")
}
